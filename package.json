{
  "name": "dsh-monitor",
  "version": "0.1.3",
  "private": true,
  "description": "Panneau Système : santé de la machine, du runtime DSH, du workspace konoha, des dépôts et du cluster kind-devspace",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
